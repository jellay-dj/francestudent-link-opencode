# Authentication
# "session"  : reuse the browser session of the account owner. Create
#              .fs-session.json with: node scripts\fs_session_login.js
# "api_key"  : use an official France Student API key. The account must have
#              the API key feature enabled (GET /user/@me/api-key).
FS_AUTH_MODE=session
FS_API_KEY=

# Client metadata sent with every France Student request.
FS_CLIENT_PLATFORM=web_fs_ai
FS_CLIENT_VERSION=ac0e023

# France Student project the conversations are created in. Empty disables it.
FS_PROJECT_ID=cf8e2f44-ca9c-49e9-b358-8714cf6e508f

# Quotas the bridge stays below (published limits: 50 new chats per day and
# 100 chat messages per hour). 0 disables a guard.
FS_MAX_MESSAGES_PER_HOUR=60
FS_MAX_NEW_CHATS_PER_DAY=40
FS_QUOTA_WAIT_TIMEOUT=600

# Forward the OpenCode system prompt to France Student. Off by default: the
# models read it as "this chat is the engine of an external agent" and refuse
# to act.
FS_FORWARD_SYSTEM_PROMPT=false

# Legacy reverse-engineered consumer login only. This is not the official API
# authentication. Leave blank unless the SSO fallback is needed.
FS_EMAIL=
FS_PASSWORD=

BIND_HOST=127.0.0.1
BIND_PORT=8765
PUBLIC_BASE_URL=http://127.0.0.1:8765
FS_IMAGE_MODEL=gpt-5.6-sol
FS_IMAGE_AGENT_ID=64
FS_REQUIRE_OPENCODE_SESSION=true

# Long-running model requests (seconds). The per-conversation cap stays finite.
FS_REQUEST_TIMEOUT=120
FS_SSE_CONNECT_TIMEOUT=30
FS_SSE_READ_TIMEOUT=1200
FS_SSE_WRITE_TIMEOUT=60
FS_SSE_POOL_TIMEOUT=30
FS_CHAT_TOTAL_TIMEOUT=1800

# Diagnostics only. FS_DEBUG_REQUEST logs the shape of the incoming request,
# FS_DEBUG_REQUEST_DUMP writes it to a file for inspection.
FS_DEBUG_REQUEST=
FS_DEBUG_REQUEST_DUMP=
